PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/dress-shop
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme_refresh
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Used to build links in emails (password reset) — the web storefront's own URL
WEB_URL=http://localhost:4002

# Optional — omit to auto-provision a throwaway Ethereal test inbox instead
# (emails aren't really delivered, but sending genuinely works and a preview
# link is logged to the console). Set these to point at a real SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sartora" <no-reply@sartora.example>

# Optional — path to a Firebase service-account JSON key file, used to send
# real push notifications (promotions, etc.) via Firebase Cloud Messaging.
# Without it, push sends are silently skipped (logged once) rather than
# failing the request that triggered them. Create a project at
# https://console.firebase.google.com, then Project settings → Service
# accounts → Generate new private key, and point this at the downloaded file.
FIREBASE_SERVICE_ACCOUNT_PATH=
