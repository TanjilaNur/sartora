# Copy to .env and fill in for your environment. Both have working defaults
# for local development, so this file is optional until you deploy for real.

# Backend API base URL (no trailing slash, no /api suffix)
VITE_API_BASE_URL=http://localhost:4000

# Stripe publishable key — replace before accepting real card payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# Google OAuth client ID — replace before enabling "Sign in with Google"
# (must match backend's GOOGLE_CLIENT_ID and be registered for this origin)
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com

# Firebase config — replace before enabling push notifications. From Firebase
# console → Project settings → General → Your apps → (add a Web app).
# VITE_FIREBASE_VAPID_KEY is separate: Project settings → Cloud Messaging →
# Web configuration → Generate key pair.
# NOTE: public/firebase-messaging-sw.js needs these same values hardcoded too
# (a static file served as-is, not processed by Vite, so it can't read this
# .env) — see the placeholder block at the top of that file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
